# Example environment variables for EXTERNAL frontend development ONLY
# 
# IMPORTANT: You only need this if you're running npm run dev OUTSIDE of Home Assistant
# (e.g., on your laptop while testing against a remote HA instance).
#
# When running INSIDE Home Assistant as an add-on, authentication happens automatically
# via SUPERVISOR_TOKEN - no manual token needed!
#
# To use this for external development:
# 1. Copy this file to .env.local
# 2. Get a long-lived access token from your HA profile
# 3. Fill in your values below
# 4. .env.local is gitignored and will NOT be committed

HASS_API_URL=http://localhost:8123/api/
HASS_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN_FROM_HA_PROFILE_HERE
NODE_ENV=development