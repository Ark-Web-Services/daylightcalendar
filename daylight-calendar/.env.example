# Example environment variables for local frontend development with npm run dev
# Copy this file to .env.local and fill in your actual values.
# .env.local should be in your .gitignore file and NOT be committed.

HASS_API_URL=http://localhost:8123/api/
HASS_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN_FROM_HA_PROFILE_HERE
NODE_ENV=development