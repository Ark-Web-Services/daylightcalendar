#!/usr/bin/env bashio
# ==============================================================================
# Take down the S6 supervision tree when Daylight Calendar fails.
#
# This was an execline script containing bash `if [ ... ]; then` blocks (for an
# on-device kiosk that no longer exists), which execline cannot parse — so the
# halt below never ran. It now follows the current Home Assistant add-on template
# for s6-overlay v3.
# ==============================================================================
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
  bashio::log.warning "Daylight Calendar exited with code ${1}; halting the add-on"
  exec /run/s6/basedir/bin/halt
fi
